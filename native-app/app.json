{
  "expo": {
    "name": "analog clock timer",
    "slug": "clock-timer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/analog_clock_icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.andoricano.nativeapp"
    },
    "plugins": [
      [
        "expo-status-bar",
        {
          "hidden": true
        }
      ],
      [
        "expo-navigation-bar",
        {
          "hidden": true
        }
      ]
    ]
  }
}